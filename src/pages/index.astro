---
// Import collections
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const pages = await getCollection('pages');
const navItems = await getCollection('nav');

// Find the index page
const indexPage = pages.find(p => p.id === 'index');
---

<MainLayout>
	<header>
		<h1>{indexPage?.data.title ?? 'Home'}</h1>
		<div>
			<nav aria-label="Main">
				{navItems
					.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
					.map(nav => {
						const isActive = nav.id === 'index';
						return <a href={nav.data.href} class={isActive ? 'active' : ''}>{nav.data.label}</a>;
					})}
			</nav>
			<button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">🌙</button>
		</div>
	</header>
	{indexPage && <article>{indexPage.body}</article>}
</MainLayout>
