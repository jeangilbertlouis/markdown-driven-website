{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "siteName": {
      "type": "string",
      "defaultValue": "[toLower(uniqueString(resourceGroup().id, deployment().name))]",
      "metadata": {
        "description": "The name of the Static Web App (must be unique globally)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [
        "Free",
        "Standard"
      ],
      "metadata": {
        "description": "SKU tier for the Static Web App"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2022-09-01",
      "name": "[toLower(parameters('siteName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "tier": "[parameters('sku')]",
        "name": "[parameters('sku')]"
      },
      "properties": {
        "provider": "GitHub",
        "repositoryUrl": "https://github.com/jeangilbertlouis/markdown-driven-website",
        "branch": "main",
        "buildProperties": {
          "appLocation": "/",
          "outputLocation": "dist",
          "appBuildCommand": "npm run build"
        }
      }
    }
  ],
  "outputs": {
    "swaName": {
      "type": "string",
      "value": "[toLower(parameters('siteName'))]"
    },
    "swaDefaultHostUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', toLower(parameters('siteName'))), '2022-09-01').defaultHostname]"
    },
    "swaRepositoryUrl": {
      "type": "string",
      "value": "https://github.com/jeangilbertlouis/markdown-driven-website"
    }
  }
}
